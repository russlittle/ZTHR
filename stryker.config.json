{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "apps/advocate/src/domain/tone.ts",
    "apps/advocate/src/eligibility/engine.ts",
    "apps/advocate/src/finder/finder.ts",
    "apps/advocate/src/guide/admission.ts",
    "apps/advocate/src/guide/barriers.ts",
    "apps/advocate/src/guide/feed.ts",
    "apps/advocate/src/guide/feedback.ts",
    "apps/advocate/src/guide/signals.ts",
    "packages/gates/src/datum.ts",
    "packages/gates/src/gate.ts",
    "packages/gates/src/hash.ts",
    "packages/gates/src/ratchet.ts",
    "packages/gates/src/register.ts",
    "packages/gates/src/verdict.ts",
    "packages/runtime/src/approval.ts",
    "packages/runtime/src/governor.ts",
    "packages/runtime/src/ledger.ts",
    "packages/runtime/src/safety.ts",
    "packages/runtime/src/sandwich.ts",
    "packages/runtime/src/sealed.ts"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 60000,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "dryRunTimeoutMinutes": 20,
  "ignoreStatic": true
}

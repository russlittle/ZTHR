{
  "name": "zthr-rules-test",
  "private": true,
  "type": "module",
  "description": "Checks firestore.rules in the Firestore emulator. Run in Cloud Shell: npm ci && npm test",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-zthr \"node --test rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^14.0.0"
  }
}

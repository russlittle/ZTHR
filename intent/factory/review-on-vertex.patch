   });
 });
+
+describe('a sequential panel stops paying once a seat fails', () => {
+  it('asks the seats in order and leaves the rest unknown after a failure', async () => {
+    const { reviewPanel } = await import('../src/index.js');
+    const { TwinModelClient } = await import('@zthr/models');
+    const asked: string[] = [];
+    const seat = (family: string, verdict: 'pass' | 'fail') => ({
+      role: 'unaided' as const,
+      family,
+      model: family,
+      client: new TwinModelClient((req) => {
+        asked.push(req.model);
+        return JSON.stringify({ verdict, findings: verdict === 'fail' ? [{ severity: 'blocker', summary: 'wrong' }] : [] });
+      }),
+    });
+    const r = await reviewPanel([seat('a', 'fail'), seat('b', 'pass'), seat('c', 'pass')], { diff: 'd', intent: 'i' }, { sequential: true });
+    expect(asked).toEqual(['a']);
+    expect(r.verdict.status).toBe('fail');
+    const all = await reviewPanel([seat('a', 'pass'), seat('b', 'pass'), seat('c', 'pass')], { diff: 'd', intent: 'i' }, { sequential: true });
+    expect(all.verdict.status).toBe('pass');
+  });
+});

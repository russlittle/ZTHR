+type SeatCfg = { role: SeatRole; family: string; model: string; base?: string; auth?: 'gcloud' | 'none' };
+const cfg = parse(readFileSync(`${CONTROL}/review.yaml`, 'utf8')) as { seats: SeatCfg[]; sequential?: boolean };
+// A seat with a base calls that OpenAI-compatible endpoint: Vertex with a short-lived token from gcloud (never stored),

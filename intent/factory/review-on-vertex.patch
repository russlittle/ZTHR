-/** The panel requires at least three distinct families before commit. */
-export async function reviewPanel(seats: Seat[], input: ReviewInput): Promise<{ verdict: Verdict; findings: Finding[] }> {
+/**
+ * The panel requires at least three distinct families before commit. Sequential, in the order the seats are listed
+ * (cheapest first), stops at the first seat that fails: a change one family has failed is not admitted whatever the
+ * others say, so asking them is spend with no information in it. Seats not asked are unknown, which never admits.
+ */
+export async function reviewPanel(seats: Seat[], input: ReviewInput, opts: { sequential?: boolean } = {}): Promise<{ verdict: Verdict; findings: Finding[] }> {
   const pre = seats.filter((s) => s.role !== 'in-place');
   const families = new Set(pre.map((s) => s.family));
   if (families.size < 3) return { verdict: fail('review-panel', `only ${families.size} model families before commit; three are required`), findings: [] };
-  const results = await Promise.all(pre.map((s) => reviewSeat(s, input)));
+  if (!opts.sequential) {
+    const results = await Promise.all(pre.map((s) => reviewSeat(s, input)));
+    return { verdict: combine('review-panel', results.map((r) => r.verdict)), findings: results.flatMap((r) => r.findings) };
+  }
+  const results: { verdict: Verdict; findings: Finding[] }[] = [];
+  for (const s of pre) {
+    const r = await reviewSeat(s, input);
+    results.push(r);
+    if (r.verdict.status === 'fail') {
+      for (const rest of pre.slice(results.length)) results.push({ verdict: unknown(`review:${rest.role}:${rest.family}`, 'not asked: an earlier seat failed the change'), findings: [] });
+      break;
+    }
+  }
   return { verdict: combine('review-panel', results.map((r) => r.verdict)), findings: results.flatMap((r) => r.findings) };
 }

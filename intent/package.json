{
  "name": "zthr-intent",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Capture what people mean, read it back, and release it as the datum a factory builds to.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "intent": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "gates": "node tools/gates.ts",
    "verify": "npm run typecheck && npm test && npm run secrets && npm run build -- --out ../.site-check && npm run build -- --out ../.site-check-open --open",
    "secrets": "node tools/secret-scan.ts",
    "build": "node tools/build-site.ts"
  },
  "devDependencies": {
    "@duckdb/node-api": "^2.0.1-r.1",
    "@prisma/prisma-schema-wasm": "^8.1.0-2.59be4fda12412a79eeb9c2ae727b6aa723593323",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "firebase": "^13.4.0"
  }
}

{
  "hosting": {
    "public": "docs",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "CNAME",
      ".nojekyll",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self'"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "regex": "^/advocate/(?P<rest>.+)$",
        "destination": "/studentadvocate/:rest",
        "type": 301
      },
      {
        "source": "/studentadvocate",
        "destination": "https://advocate-fsy7whk33q-uc.a.run.app/studentadvocate/",
        "type": 302
      },
      {
        "regex": "^/studentadvocate/(?P<rest>.*)$",
        "destination": "https://advocate-fsy7whk33q-uc.a.run.app/studentadvocate/:rest",
        "type": 302
      },
      {
        "source": "/twins",
        "destination": "https://advocate-fsy7whk33q-uc.a.run.app/twins",
        "type": 302
      },
      {
        "regex": "^/twins/(?P<rest>.*)$",
        "destination": "https://advocate-fsy7whk33q-uc.a.run.app/twins/:rest",
        "type": 302
      }
    ]
  }
}

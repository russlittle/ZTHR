{
  "hosting": {
    "public": "docs",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "CNAME",
      ".nojekyll",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/advocate",
        "run": {
          "serviceId": "advocate",
          "region": "us-central1"
        }
      },
      {
        "source": "/advocate/**",
        "run": {
          "serviceId": "advocate",
          "region": "us-central1"
        }
      },
      {
        "source": "/twins",
        "run": {
          "serviceId": "advocate",
          "region": "us-central1"
        }
      },
      {
        "source": "/twins/**",
        "run": {
          "serviceId": "advocate",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/reference",
        "destination": "/reference/index",
        "type": 301
      }
    ]
  }
}

{
  "hosting": {
    "public": "docs",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "CNAME",
      ".nojekyll",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-+9LedYjVI1JDjmF6yQqhm8VwG4+6Qgrfb68H4vNQyjw=' 'sha256-UQ9J/sqhA3sPaHFRGGWPrnqAt8lMfBuInkGcggKDJ2c=' 'sha256-canCCEijj4sgfhlvJj2a+xYBaslX14b6ywYlykNE2R0='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://advocate-fsy7whk33q-uc.a.run.app https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          }
        ]
      },
      {
        "source": "/security.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/reference/guide/v1/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/.well-known/security.txt",
        "destination": "/security.txt"
      }
    ],
    "redirects": [
      {
        "regex": "^/advocate/(?P<rest>.+)$",
        "destination": "/studentadvocate/:rest",
        "type": 301
      },
      {
        "source": "/studentadvocate",
        "destination": "https://advocate-fsy7whk33q-uc.a.run.app/studentadvocate/",
        "type": 302
      },
      {
        "regex": "^/studentadvocate/(?P<rest>.*)$",
        "destination": "https://advocate-fsy7whk33q-uc.a.run.app/studentadvocate/:rest",
        "type": 302
      },
      {
        "source": "/twins",
        "destination": "https://advocate-fsy7whk33q-uc.a.run.app/twins",
        "type": 302
      },
      {
        "regex": "^/twins/(?P<rest>.*)$",
        "destination": "https://advocate-fsy7whk33q-uc.a.run.app/twins/:rest",
        "type": 302
      }
    ]
  }
}

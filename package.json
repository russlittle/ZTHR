{
  "name": "zthr-reference",
  "private": true,
  "description": "An independent, clean-room reference implementation of the ZTHR pattern language, and the Student Advocate application it builds.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gates": "tsx tools/gates.ts",
    "journeys": "tsx tools/journeys.ts",
    "lock": "tsx tools/lock.ts",
    "evidence": "tsx tools/evidence-page.ts",
    "mutation": "stryker run",
    "dev": "tsx apps/advocate/src/server/main.ts",
    "builder": "tsx tools/builder.ts",
    "signoff": "tsx tools/signoff.ts",
    "certify": "tsx tools/certify.ts",
    "add-college": "tsx tools/add-college.ts",
    "docs": "tsx tools/docs.ts",
    "docs:check": "tsx tools/docs.ts --check",
    "explore": "tsx tools/explore.ts",
    "crawl": "tsx tools/crawl.ts",
    "walk": "tsx tools/ui/walk.ts",
    "campus": "tsx apps/campus-services/src/main.ts",
    "contract": "tsx tools/contract.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.0.0",
    "@stryker-mutator/vitest-runner": "^9.0.0",
    "@types/node": "^22.10.0",
    "axe-core": "^4.14.0",
    "marked": "15.0.12",
    "mermaid": "11.4.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  }
}
